# MoodCode 环境配置模板
#
# 用法：cp .env.example .env，然后至少填入 ANTHROPIC_API_KEY
#
# 优先级（低 → 高）：
#   代码默认值 → ~/.mood/config.toml → .mood/config.toml → .env → 系统环境变量
# 本文件的值不会覆盖已存在的系统环境变量（load_dotenv(override=False)）。

# ── 必填 ─────────────────────────────────────────────────────
# 缺失时守护进程拒绝启动——即使只跑 `mood ping` 也需要，
# 因为 provider 在 server.start() 之前就构造了。
# 使用第三方 Anthropic 兼容端点（如 DeepSeek）时，配合下面的 ANTHROPIC_BASE_URL。
ANTHROPIC_API_KEY=

# ── Core 守护进程 ────────────────────────────────────────────
MOOD_HOST=127.0.0.1
MOOD_PORT=7437
# 容器内 MOOD_HOST 必须为 0.0.0.0，否则 docker 端口映射无法到达

# ── 日志 ─────────────────────────────────────────────────────
MOOD_LOG_LEVEL=INFO
MOOD_LOG_FILE=~/.mood/logs/core.log
MOOD_LOG_FORMAT=text
# MOOD_LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
# MOOD_LOG_FILE:  留空则仅输出 stderr，不写文件
# MOOD_LOG_FORMAT: text（人工可读）| json（结构化，适合日志聚合）

# ── LLM ──────────────────────────────────────────────────────
# MOOD_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=
#   第三方 Anthropic 兼容端点。例如 DeepSeek：
#     ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
#     MOOD_LLM_DEFAULT_MODEL=deepseek-v4-pro
#   注意：不显式设置模型名时，服务端会把未知模型静默回退到便宜档位。

# ── Agent ────────────────────────────────────────────────────
# MOOD_MAX_STEPS=20
#   单次运行的最大步数（正整数）

# ── 追踪 ─────────────────────────────────────────────────────
# MOOD_TRACE_ENABLED=true
# MOOD_TRACE_FILE=~/.mood/traces/daemon.jsonl
# MOOD_TRACE_INCLUDE_LLM_PAYLOAD=true
#   最后一个设为 false 时，LLM 记录只保留摘要，不写完整载荷

# ── 权限 ─────────────────────────────────────────────────────
# MOOD_PERMISSION_TIMEOUT_S=60.0
#   权限询问超时秒数，0 表示不超时

# ── 上下文压缩 ───────────────────────────────────────────────
# MOOD_COMPACT_THRESHOLD=0.0
#   自动压缩触发阈值，取值 0~1；0 表示关闭
# MOOD_COMPACT_TOOL_LIMIT=8000
# MOOD_COMPACT_TOOL_KEEP=4000
#   ⚠️ 这两个键目前不生效：代码实际使用的是 compact/budget.py 里的模块常量

# ── TUI ──────────────────────────────────────────────────────
# MOOD_TUI_LOG_FILE=~/.mood/logs/tui.log

# ── 配置文件路径 ─────────────────────────────────────────────
# MOOD_CONFIG=~/.mood/config.toml
#   设置后只读该文件，跳过 ~/.mood/config.toml 和 .mood/config.toml
