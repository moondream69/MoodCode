# ── 环境与密钥 ────────────────────────────────────────────────
.env
.venv/

# ── Python 产物 ──────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# ── 工具缓存 ─────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ── 运行时产物 ────────────────────────────────────────────────
runs/
workspace/
*.log

# ── 锁文件 ───────────────────────────────────────────────────
# 本项目刻意不提交 uv.lock。首次 clone 后 `uv sync` 会自行解析依赖
# 并生成锁文件，Makefile 的 verify-s0 目标因此不受影响。
uv.lock

# ── 编辑器 / IDE ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── 个人文件（不共享）────────────────────────────────────────
CLAUDE.local.md
.claude/settings.local.json

# ── 系统垃圾文件 ─────────────────────────────────────────────
.DS_Store
Thumbs.db
